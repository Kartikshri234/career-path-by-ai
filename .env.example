# ══════════════════════════════════════════════
# CareerCompass — Environment Variables
# ══════════════════════════════════════════════
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your values below
#   3. Never commit .env to git (it's in .gitignore)
# ══════════════════════════════════════════════


# ── SECURITY ──────────────────────────────────
# Generate a new key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-before-going-to-production

# True for development, False for production
DEBUG=True

# Comma-separated list of allowed hosts
# Development:  ALLOWED_HOSTS=*
# Production:   ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=*


# ── DATABASE ──────────────────────────────────
# sqlite3 (default, no extra config needed)
# postgresql (requires DB_NAME, DB_USER etc. below)
DB_ENGINE=sqlite3

# Only needed if DB_ENGINE=postgresql
DB_NAME=careercompass_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432


# ── LOCALISATION ──────────────────────────────
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Kolkata
