# ══════════════════════════════════════════════
# CareerCompass — Environment Variables
# ══════════════════════════════════════════════
# HOW TO USE:
#   Development: cp .env.example .env  then fill in values
#   Production (Render): add each key in Dashboard → Environment
#
# Never commit the real .env file to git.
# ══════════════════════════════════════════════


# ── SECURITY ──────────────────────────────────
# Generate a strong key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=django-insecure-change-me-before-going-to-production

# True for local dev, False for production
DEBUG=False

# Comma-separated — add your Render URL here once deployed
# e.g. ALLOWED_HOSTS=careercompass.onrender.com,yourdomain.com
ALLOWED_HOSTS=*


# ── DATABASE ──────────────────────────────────
# sqlite3  → uses local db.sqlite3 file (fine for small/free Render deploys)
# postgresql → requires the DB_* variables below
DB_ENGINE=sqlite3

# Only needed if DB_ENGINE=postgresql
DB_NAME=careercompass_db
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_HOST=localhost
DB_PORT=5432


# ── LOCALISATION ──────────────────────────────
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Kolkata
